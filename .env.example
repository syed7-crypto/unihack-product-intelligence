# Gemini configuration placeholders. Do not add real secrets here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional governed source discovery pilot. No fake fallback is used when unset.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_TIMEOUT=15
BRAVE_SEARCH_COUNTRY=US
BRAVE_SEARCH_LANG=en

# Optional alternative Google-result provider for the selected pilot only.
SERPER_API_KEY=
SERPER_SEARCH_ENDPOINT=https://google.serper.dev/search
SERPER_SEARCH_TIMEOUT=15
SERPER_SEARCH_COUNTRY=us
SERPER_SEARCH_LANGUAGE=en
